# ==============================
# GameForge Server - Environment Variables
# Copy this file to .env and fill in your values
# ==============================

# Server
PORT=5000

# MongoDB
MONGODB_URI=mongodb://127.0.0.1:27017/gameforge
# For MongoDB Atlas:
# MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/gameforge

# JWT Secrets — use strong, random strings (min 32 chars)
JWT_ACCESS_SECRET=replace_with_a_long_random_secret
JWT_REFRESH_SECRET=replace_with_a_different_long_random_secret

# JWT Expiry
ACCESS_TOKEN_EXPIRY=15m
REFRESH_TOKEN_EXPIRY=7d

# Client URL (used for CORS and email links)
CLIENT_URL=http://localhost:5173

# Henrik Dev API (Valorant account verification)
# Get your key at: https://henrikdev.xyz/
HENRIK_API_KEY=HDEV-your-api-key-here
HENRIK_BASE_URL=https://api.henrikdev.xyz

# Email / SMTP (Gmail recommended)
# For Gmail, use an App Password: https://myaccount.google.com/apppasswords
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USER=your-email@gmail.com
MAIL_PASSWORD=your_gmail_app_password

# Cloudinary (Image uploads)
# Sign up at: https://cloudinary.com/
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Google OAuth
# Create credentials at: https://console.cloud.google.com/
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com

# Razorpay (Payments)
# Sign up at: https://razorpay.com/
# Use test keys for development, live keys for production
RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your_razorpay_secret

# Challonge API (v2.1 — Online Bracket Generation)
# Register your app at: https://connect.challonge.com/
# Use the Client ID and Secret from your Challonge OAuth2 application
CHALLONGE_CLIENT_ID=your_challonge_client_id
CHALLONGE_CLIENT_SECRET=your_challonge_client_secret
